<?xml version="1.0" encoding="utf-8"?>
<!-- kbs.storage.backend — form / list / menu. Phase 6 adds health check UI. -->
<odoo>
    <record id="view_kbs_storage_backend_form" model="ir.ui.view">
        <field name="name">kbs.storage.backend.form</field>
        <field name="model">kbs.storage.backend</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="backend_code"/>
                            <field name="is_default"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="bucket"/>
                            <field name="region"/>
                            <field name="endpoint"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="options" string="Provider Options">
                            <field name="options_json" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kbs_storage_backend_tree" model="ir.ui.view">
        <field name="name">kbs.storage.backend.tree</field>
        <field name="model">kbs.storage.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="backend_code"/>
                <field name="bucket"/>
                <field name="is_default"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_kbs_storage_backend" model="ir.actions.act_window">
        <field name="name">Storage Backends</field>
        <field name="res_model">kbs.storage.backend</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_kbs_storage_root"
        name="Storage"
        sequence="80"
        groups="base.group_system"/>
    <menuitem
        id="menu_kbs_storage_config"
        name="Configuration"
        parent="menu_kbs_storage_root"/>
    <menuitem
        id="menu_kbs_storage_backend"
        name="Backends"
        parent="menu_kbs_storage_config"
        action="action_kbs_storage_backend"/>
</odoo>
